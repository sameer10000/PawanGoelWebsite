# Copy to .env for local development. Never commit the real .env.
# In production these are set as Firebase App Hosting secrets — see apphosting.yaml.

# ---------------------------------------------------------------------------
# Database — Railway Postgres
# ---------------------------------------------------------------------------
# Railway → your Postgres service → Variables → DATABASE_PUBLIC_URL
# Local development connects to the same Railway database, or to a second
# Railway database if you want development data kept separate.
#
# Uploaded photos are stored in this database too, so there is no separate
# object-storage service to configure.
DATABASE_URL="postgresql://user:password@host.proxy.rlwy.net:5432/railway"

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signs the admin session cookie. Must be 32+ characters.
# Generate: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Used for canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# First-run admin account (used once by `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@drpawangoel.in"
# Leave blank and the seed generates a random password and prints it once.
ADMIN_PASSWORD=""

# Set to 1 only to deliberately overwrite live content with the starter data.
# SEED_FORCE=1
